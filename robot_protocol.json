  "config_relations": [
    {
      "python": "gentle_current_ma <= normal_current_ma <= boost_current_ma",
      "cpp": "c.gentle_current_ma <= c.normal_current_ma && c.normal_current_ma <= c.boost_current_ma",
      "message": "Profile current caps must be Gentle <= Normal <= Boost"
    },
    {
      "python": "neutral_brake_ma <= max_current_ma and hold_current_ma <= max_current_ma",
      "cpp": "c.neutral_brake_ma <= c.max_current_ma && c.hold_current_ma <= c.max_current_ma",
      "message": "Braking and holding caps cannot exceed the independent current ceiling"
    },
    {
      "python": "temp_release_c < temp_warn_c < temp_derate_c < temp_limit_c",
      "cpp": "c.temp_release_c < c.temp_warn_c && c.temp_warn_c < c.temp_derate_c && c.temp_derate_c < c.temp_limit_c",
      "message": "Temperature thresholds must be release < warn < derate < stop"
    },
    {
      "python": "temp_release_c + temp_hysteresis_c < temp_derate_c",
      "cpp": "c.temp_release_c + c.temp_hysteresis_c < c.temp_derate_c",
      "message": "Thermal release hysteresis must remain below derating"
    },
    {
      "python": "temp_poll_ms < temp_boost_stale_ms < temp_stop_stale_ms",
      "cpp": "c.temp_poll_ms < c.temp_boost_stale_ms && c.temp_boost_stale_ms < c.temp_stop_stale_ms",
      "message": "Temperature timing must be poll < Boost stale < stop stale"
    },
    {
      "python": "boost_refill_ms >= boost_capacity_ms",
      "cpp": "c.boost_refill_ms >= c.boost_capacity_ms",
      "message": "Boost refill time must be at least its capacity duration"
    },
    {
      "python": "stall_speed_centi_rpm < stall_target_centi_rpm",
      "cpp": "c.stall_speed_centi_rpm < c.stall_target_centi_rpm",
      "message": "Stall measured speed threshold must be below its target threshold"
    },
    {
      "python": "control_period_ms < feedback_timeout_ms < watchdog_ms",
      "cpp": "c.control_period_ms < c.feedback_timeout_ms && c.feedback_timeout_ms < c.watchdog_ms",
      "message": "Timing must be control period < feedback timeout < command watchdog"
    },
    {
      "python": "not disarmed_hold_enabled or hold_enabled",
      "cpp": "!c.disarmed_hold_enabled || c.hold_enabled",
      "message": "Disarmed holding requires holding to be enabled"
    },
    {
      "python": "temp_release_c < hold_temp_c <= temp_limit_c",
      "cpp": "c.temp_release_c < c.hold_temp_c && c.hold_temp_c <= c.temp_limit_c",
      "message": "Holding thermal limit must be above release and at or below stop"
    }
  ]
