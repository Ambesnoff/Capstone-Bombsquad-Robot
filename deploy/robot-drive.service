[Unit]
Description=Four-wheel robot supervisor (deliberate radio arming required)
After=local-fs.target

[Service]
Type=simple
User=robot
SupplementaryGroups=dialout
WorkingDirectory=/home/robot/robot
ExecStart=/home/robot/robot/.venv/bin/python /home/robot/robot/deploy/run_service.py
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=12
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
